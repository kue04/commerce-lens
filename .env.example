# 所有连接字符串和 API Key 只在服务端使用；不要提交 .env。
# npm run demo / test 自行启动本地 PostgreSQL，不需要这两个变量。
DATABASE_URL=
READONLY_DATABASE_URL=
APP_DATABASE_URL=
# deterministic: real PostgreSQL calculations; agent: real Pi + DeepSeek, requires credentials.
ANALYSIS_MODE=deterministic
# M0 验证脚本在没有 Key 时只检查 SDK 和 provider，不发起模型请求。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
