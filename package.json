{
  "name": "commerce-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "api:dev": "tsx scripts/api-dev.ts",
    "api:start": "tsx scripts/api-start.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "eval:offline": "tsx scripts/evaluate-offline.ts",
    "benchmark:local": "tsx scripts/benchmark-local.ts",
    "release:source": "tsx scripts/release.ts",
    "contracts:examples": "tsx scripts/contract-examples.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=60000 tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 --test-timeout=60000 tests/integration/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "db:start": "tsx scripts/database.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:scenarios": "tsx scripts/seed-scenarios.ts",
    "db:backup": "tsx scripts/snapshot.ts backup",
    "db:restore": "tsx scripts/snapshot.ts restore",
    "verify:pi": "tsx scripts/verify-pi.ts",
    "verify:scale": "tsx scripts/verify-scale.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "fastify": "5.12.7",
    "pg": "8.16.3",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
